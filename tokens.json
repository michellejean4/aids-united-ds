{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "AIDS United Design System — source of truth for colors, type, spacing, radii, shadows, and grid. Names here match Webflow swatch/class names and Figma style names exactly.",
  "$version": "1.0.0",
  "$updated": "2026-05-30",

  "color": {
    "brand": {
      "brand-red":  { "$value": "#C42032", "$type": "color", "$description": "Primary brand red — must match logo. Use for primary buttons, eyebrow labels, accent moments. NOT orange-red." },
      "red-dark":   { "$value": "#A01A2A", "$type": "color", "$description": "Hover state for brand red." },
      "red-light":  { "$value": "#F9F0F0", "$type": "color", "$description": "Soft red tint — backgrounds, hover surfaces. NEVER pink." },
      "brand-blue": { "$value": "#3C73A1", "$type": "color", "$description": "Secondary brand blue — donations, info accents." },
      "blue-dark":  { "$value": "#1A6BA9", "$type": "color", "$description": "Hover state for brand blue." },
      "blue-light": { "$value": "#E8F0F7", "$type": "color", "$description": "Soft blue tint — info backgrounds." }
    },
    "neutral": {
      "dark":         { "$value": "#1A1A1A", "$type": "color", "$description": "Headings on light backgrounds, dark section backgrounds." },
      "dark-gray":    { "$value": "#333333", "$type": "color", "$description": "Default body text color." },
      "medium-gray":  { "$value": "#666666", "$type": "color", "$description": "Secondary text, meta, captions." },
      "light-gray":   { "$value": "#F5F5F5", "$type": "color", "$description": "Section backgrounds, card alternates." },
      "border-gray":  { "$value": "#E0E0E0", "$type": "color", "$description": "Default border color." },
      "white":        { "$value": "#FFFFFF", "$type": "color", "$description": "Card backgrounds, button text on dark." }
    }
  },

  "typography": {
    "family": {
      "display": { "$value": "Playfair Display", "$type": "fontFamily", "$description": "Headings only. Weights 700, 800, 900." },
      "body":    { "$value": "Inter",            "$type": "fontFamily", "$description": "Body, UI, buttons, forms. Weights 400, 500, 600, 700, 800, 900." }
    },
    "scale": {
      "heading-h1":   { "$type": "typography", "$description": "Hero headlines",
        "$value": { "fontFamily": "Playfair Display", "fontWeight": 800, "fontSize": "62px", "lineHeight": "1.05", "letterSpacing": "-2.5px", "tabletFontSize": "48px", "mobileFontSize": "36px" } },
      "heading-h2":   { "$type": "typography", "$description": "Section titles",
        "$value": { "fontFamily": "Playfair Display", "fontWeight": 800, "fontSize": "40px", "lineHeight": "1.15", "letterSpacing": "-1px", "tabletFontSize": "32px", "mobileFontSize": "28px" } },
      "heading-h3":   { "$type": "typography", "$description": "Card titles",
        "$value": { "fontFamily": "Playfair Display", "fontWeight": 800, "fontSize": "28px", "lineHeight": "1.25", "letterSpacing": "-0.5px", "tabletFontSize": "24px", "mobileFontSize": "22px" } },
      "stat-number":  { "$type": "typography", "$description": "Impact stats — large red display number",
        "$value": { "fontFamily": "Playfair Display", "fontWeight": 800, "fontSize": "80px", "lineHeight": "1", "letterSpacing": "-3px", "color": "{color.brand.brand-red}" } },
      "eyebrow":      { "$type": "typography", "$description": "Small uppercase label above headlines",
        "$value": { "fontFamily": "Inter", "fontWeight": 700, "fontSize": "12px", "lineHeight": "1.4", "letterSpacing": "4px", "textTransform": "uppercase", "color": "{color.brand.brand-red}" } },
      "body-large":   { "$type": "typography", "$description": "Lead body, intros",
        "$value": { "fontFamily": "Inter", "fontWeight": 400, "fontSize": "18px", "lineHeight": "1.7", "color": "{color.neutral.medium-gray}" } },
      "body":         { "$type": "typography", "$description": "Default body",
        "$value": { "fontFamily": "Inter", "fontWeight": 400, "fontSize": "16px", "lineHeight": "1.6", "color": "{color.neutral.dark-gray}" } },
      "body-small":   { "$type": "typography", "$description": "Captions, meta",
        "$value": { "fontFamily": "Inter", "fontWeight": 400, "fontSize": "14px", "lineHeight": "1.5", "color": "{color.neutral.medium-gray}" } },
      "button":       { "$type": "typography", "$description": "Button label",
        "$value": { "fontFamily": "Inter", "fontWeight": 700, "fontSize": "14px", "lineHeight": "1", "letterSpacing": "1.5px", "textTransform": "uppercase" } }
    }
  },

  "spacing": {
    "$description": "Stick to this scale — no custom values. Use for padding, margin, gap.",
    "8":   { "$value": "8px",   "$type": "dimension" },
    "16":  { "$value": "16px",  "$type": "dimension" },
    "24":  { "$value": "24px",  "$type": "dimension" },
    "32":  { "$value": "32px",  "$type": "dimension" },
    "48":  { "$value": "48px",  "$type": "dimension" },
    "64":  { "$value": "64px",  "$type": "dimension" },
    "80":  { "$value": "80px",  "$type": "dimension", "$description": "Default section padding (top/bottom)" },
    "100": { "$value": "100px", "$type": "dimension", "$description": "Major section padding" },
    "120": { "$value": "120px", "$type": "dimension" }
  },

  "radius": {
    "button": { "$value": "8px",  "$type": "dimension", "$description": "All buttons, inputs, small surfaces" },
    "card":   { "$value": "16px", "$type": "dimension", "$description": "All cards, large containers" },
    "pill":   { "$value": "999px","$type": "dimension", "$description": "Pills, badges, status tags" }
  },

  "shadow": {
    "sm": { "$value": "0 1px 2px rgba(0,0,0,0.04)",   "$type": "shadow", "$description": "Resting elevation" },
    "md": { "$value": "0 4px 16px rgba(0,0,0,0.06)",  "$type": "shadow", "$description": "Cards, dropdowns" },
    "lg": { "$value": "0 12px 40px rgba(0,0,0,0.10)", "$type": "shadow", "$description": "Card hover lift, modals" }
  },

  "layout": {
    "container-max":    { "$value": "1200px", "$type": "dimension", "$description": "Max width of main content container" },
    "container-gutter": { "$value": "24px",   "$type": "dimension", "$description": "Horizontal padding inside container" },
    "breakpoint": {
      "desktop": { "$value": "1280px", "$type": "dimension" },
      "tablet":  { "$value": "1024px", "$type": "dimension" },
      "mobile":  { "$value": "768px",  "$type": "dimension" },
      "small":   { "$value": "400px",  "$type": "dimension" }
    }
  },

  "motion": {
    "duration": {
      "fast":   { "$value": "200ms", "$type": "duration" },
      "normal": { "$value": "300ms", "$type": "duration", "$description": "Default for buttons, cards, links" }
    },
    "easing": {
      "default": { "$value": "ease",                                "$type": "cubicBezier" },
      "lift":    { "$value": "cubic-bezier(0.2, 0.8, 0.2, 1)",      "$type": "cubicBezier", "$description": "Card hover lift" }
    }
  },

  "_rules": {
    "$description": "Hard rules — non-negotiable client decisions.",
    "no-pink":             "Never use pink. Not as tint, not as gradient.",
    "true-red":            "Brand Red is #C42032 exactly — not the orange-red on the current site.",
    "no-homemade-icons":   "Use a real icon set (e.g., Lucide, Phosphor) — no hand-drawn icons.",
    "no-sticky-donate":    "No floating donate button — header donate link is enough.",
    "localization":        "Webflow Localization handles EN/ES translation. Don't bake English copy into image assets."
  }
}
